          "in-app-messaging.firebase.googleapis.com",
          "settings.crashlytics.com"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "regexp:.*\\.ru$",
          "regexp:.*\\.su$",
          "regexp:.*\\.by$",
          "regexp:.*\\.xn--p1ai$",
          "vk.com",
          "userapi.com",
          "vk-portal.net",
          "mycdn.me",
          "yandex.ru",
          "yastatic.net",
          "ya.ru",
          "2gis.com",
          "ozon.ru",
          "ozon.com",
          "ozonusercontent.com",
