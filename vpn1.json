{
  "dns": {
    "hosts": {
      "dns.google": "8.8.8.8",
      "cloudflare-dns.com": "1.1.1.1"
    },
    "servers": [
      "https://cloudflare-dns.com/dns-query",
      {
        "address": "https://cloudflare-dns.com/dns-query",
        "domains": []
      }
    ],
    "queryStrategy": "UseIPv4"
  },
  "log": {
    "loglevel": "warning"
  },
  "policy": {
    "levels": {
      "8": {
        "connIdle": 300,
        "handshake": 4,
        "uplinkOnly": 1,
        "downlinkOnly": 1
      }
    }
  },
  "routing": {
