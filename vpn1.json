          "bittorrent"
        ],
        "outboundTag": "direct"
      },
      {
        "port": 443,
        "type": "field",
        "network": "udp",
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "domain:push.apple.com",
          "domain:api.push.apple.com",
          "domain:push-apple.com.akadns.net",
          "domain:mtalk.google.com",
          "domain:mobile.events.data.microsoft.com",
          "regexp:.*-courier\\.push\\.apple\\.com$"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "17.0.0.0/8"
        ],
        "type": "field",
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "tiktok.com",
          "tiktokcdn.com",
          "tiktokv.com",
          "tiktokcdn-us.com",
          "byteoversea.com",
          "ibytedtos.com",
          "muscdn.com",
          "musical.ly",
